{
  "setup": "cd kermanych && pnpm install --frozen-lockfile && pnpm --filter '@kermanych/ui^...' build",
  "services": [
    {
      "name": "api",
      "command": "cd kermanych/apps/api && node dist/main.js",
      "env": {
        "KERMANYCH_DB": "${PREVIEW_DIR}/registry.sqlite",
        "KERMANYCH_SEED": "1",
        "KERMANYCH_PREVIEW": "1"
      }
    },
    {
      "name": "web",
      "open": true,
      "command": "cd kermanych/apps/ui && pnpm exec quasar dev",
      "env": {
        "VITE_API_BASE": "http://localhost:${PORT_API}/api",
        "VITE_KERMANYCH_PREVIEW": "1"
      }
    }
  ]
}
