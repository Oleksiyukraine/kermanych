{
  "setup": "cd kermanych && pnpm install && pnpm --filter '@kermanych/ui^...' build",
  "services": [
    {
      "name": "api",
      "command": "cd kermanych && pnpm --filter @kermanych/api start",
      "env": {
        "KERMANYCH_DB": "${PREVIEW_DIR}/kermanych.sqlite",
        "KERMANYCH_SEED": "1",
        "KERMANYCH_PREVIEW": "1"
      }
    },
    {
      "name": "web",
      "open": true,
      "command": "cd kermanych && pnpm --filter @kermanych/ui exec quasar dev",
      "env": {
        "VITE_API_BASE": "http://localhost:${PORT_API}/api",
        "VITE_KERMANYCH_PREVIEW": "1"
      }
    }
  ]
}
