.superpowers/
node_modules/
dist/

# Local secrets (Supabase CLI env() substitution reads kermanych/.env). Never committed.
.env
.env.local

# one-off migration rehearsal output (kermanych/scripts/verify-workspace-migration.ts)
.kermanych-migration-rehearsal.json

# whisper.cpp source, build and the built whisper-server for the macOS app
# (kermanych/apps/ui/scripts/build-whisper-server.sh)
kermanych/.whisper-build/

# The docs-harness index is derived data, rebuilt locally by `docs-harness docs index`
# (kermanych/docs/agents/project-docs.md); only .docs-harness/config.json is shared.
kermanych/.docs-harness/index/

# Session git worktrees (packages/core worktreeDir): one folder per session, inside the project repo.
# `.gitworktree/` is the older folder: sessions started before the move, and the release command.
.worktrees/
.gitworktree/

# The landing page is its own repository (Oleksiyukraine/kermanych-landing), sometimes cloned
# next to the product inside this checkout
kermanych-landing/
