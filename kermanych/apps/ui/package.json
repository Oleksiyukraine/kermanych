{
  "name": "@kermanych/ui",
  "version": "0.0.0",
  "description": "Kermanych v2 web UI (Quasar SPA)",
  "productName": "Kermanych",
  "type": "module",
  "private": true,
  "scripts": {
    "//deps": "The UI imports RUNTIME values from @kermanych/cloud (stores/projects.ts) and resolves it through `main: dist/index.js`, so a worktree with no build output serves a broken app. `<pkg>^...` builds this package's workspace deps in topological order, never itself. Extra pnpm args (`-m electron`) land on the LAST command, i.e. on quasar.",
    "dev": "pnpm --filter '@kermanych/ui^...' build && quasar dev",
    "build": "pnpm --filter '@kermanych/ui^...' build && quasar build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "postinstall": "quasar prepare --silent || true"
  },
  "dependencies": {
    "@kermanych/api": "workspace:*",
    "@kermanych/cloud": "workspace:*",
    "@kermanych/core": "workspace:*",
    "@kermanych/tokens": "workspace:*",
    "@quasar/extras": "^1.16.0",
    "@supabase/supabase-js": "^2",
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.1.0",
    "pinia": "^2.1.0",
    "quasar": "^2.16.0",
    "socket.io-client": "^4.8.3",
    "vue": "^3.4.0",
    "vue-i18n": "^10.0.8",
    "vue-router": "^4.0.12"
  },
  "devDependencies": {
    "@electron/packager": "^18.4.4",
    "@electron/rebuild": "^4.2.0",
    "@nestjs/common": "^10",
    "@quasar/app-vite": "2.3.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22",
    "autoprefixer": "^10.4.27",
    "electron": "^43.4.0",
    "electron-builder": "^24.13.3",
    "happy-dom": "^20.12.2",
    "postcss": "^8.4.14",
    "typescript": "^5.6",
    "vitest": "^2",
    "vue-tsc": "^2.1.0"
  },
  "engines": {
    "node": "^22 || ^24 || >= 26"
  }
}
