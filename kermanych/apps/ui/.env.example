# apps/ui/.env — copy to `.env` and fill in. The real .env is gitignored.
# Both values are PUBLIC: the anon key ships inside the browser bundle by design,
# and RLS is the authorization surface. Paste them from `supabase status` (local)
# or the project's API settings (hosted).
VITE_SUPABASE_URL=http://127.0.0.1:54421
VITE_SUPABASE_ANON_KEY=paste-the-anon-key-here
