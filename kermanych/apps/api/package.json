{
  "name": "@kermanych/api",
  "version": "0.0.0",
  "private": true,
  "main": "dist/main.js",
  "exports": { ".": "./dist/main.js" },
  "scripts": {
    "//deps": "`dist/` is gitignored, so a fresh clone or worktree has no @kermanych/core or @kermanych/cloud build output and `nest build` fails with TS2307. `<pkg>^...` is pnpm's dependencies-of-pkg-excluding-pkg selector: it builds them in topological order and cannot recurse into this package.",
    "build": "pnpm --filter '@kermanych/api^...' build && nest build",
    "typecheck": "tsc --noEmit",
    "start": "node dist/main.js",
    "start:dev": "pnpm --filter '@kermanych/api^...' build && nest start --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "@kermanych/cloud": "workspace:*",
    "@kermanych/core": "workspace:*",
    "@supabase/supabase-js": "^2",
    "@nestjs/common": "^10",
    "@nestjs/core": "^10",
    "@nestjs/platform-express": "^10",
    "@nestjs/platform-socket.io": "^10",
    "@nestjs/websockets": "^10",
    "better-sqlite3": "^13",
    "reflect-metadata": "^0.2",
    "rxjs": "^7",
    "socket.io": "^4"
  },
  "devDependencies": {
    "@nestjs/cli": "^10",
    "@types/better-sqlite3": "^7",
    "@types/node": "^22",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.23.10",
    "typescript": "^5.6",
    "vitest": "^2"
  }
}
