# kermanych/.env — OPTIONAL. You do not need this file to run Kermanych.
#
# Nothing here is required for the normal path: `pnpm i && pnpm dev:app` signs in
# against the team's hosted Supabase project, whose GitHub OAuth credentials live
# in the Supabase dashboard (Authentication → Providers → GitHub) and are never
# handed out. Copy this file to `.env` (gitignored) only for LOCAL work.
#
# GitHub sign-in against a LOCAL Supabase stack:
# `supabase/config.toml` substitutes these into [auth.external.github] via env(),
# so they must exist in the shell (or in this file) BEFORE `supabase start`.
# Create your OWN throwaway GitHub OAuth App
# (https://github.com/settings/developers) with callback URL
# http://127.0.0.1:54421/auth/v1/callback. Nobody has to share theirs.
#
# GITHUB_CLIENT_ID is public; GITHUB_SECRET is the only real secret in this repo.
GITHUB_CLIENT_ID=Ov23liXXXXXXXXXXXXXX
GITHUB_SECRET=replace-with-your-own-oauth-app-secret

# Pointing the API at a backend other than the built-in default (a local stack or
# your own fork). Export these in the shell that runs `pnpm dev:api` / `pnpm
# dev:app`; a `.env` file here is NOT loaded by the API. Set BOTH or neither —
# exactly one is a configuration error, and `cloudEnv('api')` refuses with
# `cloud env missing: …` rather than silently mixing backends. Mirror the same
# pair into `apps/ui/.env` under the VITE_ names, or the ui and the API end up on
# different backends. Both values are public; the dashboard's `Secret key`
# (`sb_secret_…`) is never read by Kermanych and must not appear anywhere.
# SUPABASE_URL=http://127.0.0.1:54421
# SUPABASE_PUBLISHABLE_KEY=<sb_publishable_… from `supabase status`>
# Legacy name, still accepted:
# SUPABASE_ANON_KEY=<anon key from `supabase status`>
